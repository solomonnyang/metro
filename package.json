{
  "name": "electricity-bill-bot",
  "version": "1.0.0",
  "description": "Telegram bot for electricity bill payment with Paystack integration",
  "main": "dist/index.js",
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build:bot": "tsc -p tsconfig.json",
    "build:admin": "npm --prefix admin install && npm --prefix admin run build",
    "build": "npm run build:bot && npm run build:admin",
    "gcp-build": "npm run build:bot && npm --prefix admin run build",
    "prestart": "npm run build:bot",
    "start": "node dist/index.js",
    "dev": "nodemon --watch src --ext ts,json --exec \"npm run build:bot && node dist/index.js\"",
    "migrate": "node dist/config/migrate.js",
    "seed": "node dist/config/seed.js",
    "fucil:check": "npm run build:bot && node dist/scripts/fucil-check.js",
    "test:vend": "npm run build:bot && node dist/scripts/vend-e2e.js",
    "wallet:credit": "node dist/scripts/wallet-credit.js",
    "payments:reconcile": "npm run build:bot && node dist/scripts/reconcile-payments.js"
  },
  "dependencies": {
    "axios": "^1.6.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.18.2",
    "helmet": "^7.1.0",
    "morgan": "^1.10.0",
    "node-telegram-bot-api": "^0.64.0",
    "pdfkit": "^0.20.2",
    "pg": "^8.12.0",
    "sequelize": "^6.35.2",
    "uuid": "^9.0.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.25",
    "@types/morgan": "^1.9.10",
    "@types/node": "^26.6.3",
    "@types/node-telegram-bot-api": "^0.64.15",
    "@types/pdfkit": "^0.17.6",
    "@types/uuid": "^9.0.8",
    "nodemon": "^3.0.2",
    "typescript": "^7.0.2"
  }
}
