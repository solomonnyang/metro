# Server Configuration
PORT=3000
NODE_ENV=development

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=electricity_bot
DB_USER=postgres
DB_PASSWORD=postgres
# Set to true for SSL-required databases. Keep false for local databases.
DB_SSL=false

# Telegram Bot Configuration
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
# true = webhook mode (Cloud Run / serverless). false = long polling (local dev).
TELEGRAM_WEBHOOK=false

# Paystack Configuration
# Paystack signs webhooks with your SECRET KEY — no separate webhook secret is needed.
PAYSTACK_SECRET_KEY=your_paystack_secret_key_here
PAYSTACK_PUBLIC_KEY=your_paystack_public_key_here

# App Configuration
APP_URL=http://localhost:3000
BOT_URL=https://api.telegram.org/bot${TELEGRAM_BOT_TOKEN}
BOT_USERNAME=MetroelectricBot


# Fucil Reseller API Configuration
FUCIL_API_KEY=your_fucil_agent_api_key
FUCIL_API_BASE_URL=https://www.fdlng.xyz/agency/api/v1
FUCIL_SANDBOX=true
FUCIL_SANDBOX_SCENARIO=success
FUCIL_WEBHOOK_SECRET=your_fucil_webhook_secret
